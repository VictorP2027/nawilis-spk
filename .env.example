# ─────────────────────────────────────────────────────────────────────────
# Nawilis SPK Bridge — environment
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────

# --- Datastores ---
# LOCAL (default, run `npm run dev:mongo`):
MONGODB_URI=mongodb://localhost:27017
# CLOUD / WEB-BASED (MongoDB Atlas) — paste your SRV string here instead, e.g.:
#   MONGODB_URI=mongodb+srv://spkuser:PASSWORD@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
#   (URL-encode special characters in the password: @ -> %40, # -> %23, etc.)
MONGODB_DB=spk
REDIS_URL=redis://localhost:6379

# --- Supabase (the separate Postgres clone: apps/web-supabase, port 3100) ---
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key...

# --- Object storage (S3-compatible: AWS S3 Jakarta / Cloudflare R2 / MinIO) ---
# Keep in-region (ap-southeast) to avoid UU PDP cross-border transfer of images.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=nawilis-spk
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Turboly push (W2 = browser automation) ---
# The base URL of your Turboly tenant (confirm the exact host from your browser).
TURBOLY_BASE_URL=https://app.turboly.com
# Where persisted Playwright sessions (cookies) live. Contains credentials — gitignored.
TURBOLY_STATE_DIR=./.turboly-state
# Ingress mode: rpa (W2) | api (W1) | manual (W3). Start on manual until selectors captured.
PUSH_MODE=manual
# Business-hours push window (WIB). Outside this, jobs stay queued.
PUSH_WINDOW_START=07:00
PUSH_WINDOW_END=20:00
# Static, DISCLOSED egress IP is configured at the network layer, not here.
PUSH_USER_AGENT_SUFFIX=NawilisSPKBridge/0.1 (+ops@nawilis.com)

# Per-branch Turboly service-account credentials are stored in Mongo (tb_credentials),
# encrypted with this key — NOT in env per-account. Provide the master key here.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENC_KEY=

# --- Concurrency / reliability ---
MAX_BROWSER_WORKERS=6
MAX_WORKERS_PER_BRANCH=2
LEASE_TTL_MS=600000
CANARY_INTERVAL_MS=300000

# --- Alerting ---
ALERT_WHATSAPP_ENABLED=false
WHATSAPP_BSP_URL=
WHATSAPP_BSP_TOKEN=
ALERT_EMAIL_TO=ops@nawilis.com

# --- Web ---
NEXT_PUBLIC_APP_NAME=Nawilis SPK
AUTH_SECRET=
